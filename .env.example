APP_NAME=RoamVenture
APP_ENV=local
APP_KEY=base64:BTizTaf01uxMRC37JuXeKOglawPh7qsDi2lTleKnxl0=
APP_DEBUG=true
APP_URL=http://roamventure.com:8888

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=debug

# MAMP MySQL defaults
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=8890
DB_DATABASE=roamventure
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=rvt_session
SESSION_SAME_SITE=lax
# Set to true when APP_URL is https
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# Customer emails (booking received). log = write to storage/logs/laravel.log only, nothing is sent.
# Production: MAIL_MAILER=smtp with the mailbox or provider details below.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=booking@roamventure.co
MAIL_FROM_NAME="RoamVenture"
# Discord channel webhook: new booking requests and slip uploads (empty = off)
DISCORD_WEBHOOK_URL=
# Google reCAPTCHA v3 on the booking form (https://www.google.com/recaptcha/admin, type "Score based (v3)").
# Leave either key empty to turn the check off. MIN_SCORE: 0.0 = bot … 1.0 = human.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
